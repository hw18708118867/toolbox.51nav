---
import { tools } from '../../data/tools-registry';
import { getCategoryById } from '../../data/categories';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorials');

// 服务端构建搜索索引：工具 + 教程，纯前端即可检索，无需网络请求
const index = [
  ...tools.map((t) => ({
    type: 'tool',
    title: t.name,
    subtitle: getCategoryById(t.category)?.name || '',
    desc: t.description,
    href: `/tools/${t.category}/${t.id}`,
    kw: (t.keywords || []).join(' '),
  })),
  ...tutorials.map((t) => ({
    type: 'tutorial',
    title: t.data.title,
    subtitle: '教程',
    desc: t.data.description || '',
    href: `/tutorials/${t.slug}`,
    kw: (t.data.keywords || []).join(' '),
  })),
];
---

<div id="global-search" class="gs-overlay" aria-hidden="true">
  <div class="gs-modal" role="dialog" aria-modal="true" aria-label="搜索工具与教程">
    <div class="gs-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: var(--color-text-muted); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.35-4.35" />
      </svg>
      <input
        id="gs-input"
        type="text"
        placeholder="搜索工具或教程…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索"
      />
      <kbd class="gs-kbd" id="gs-esc">ESC</kbd>
    </div>
    <div id="gs-results" class="gs-results"></div>
    <div class="gs-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>esc</kbd> 关闭</span>
      <span class="gs-count" id="gs-count"></span>
    </div>
  </div>
</div>

<!-- 注入搜索索引（内联，确保早于下方模块脚本执行） -->
<script is:inline define:vars={{ SEARCH_INDEX: index }}>
  window.__SEARCH_INDEX__ = SEARCH_INDEX;
</script>

<script>
  const overlay = document.getElementById('global-search');
  const input = document.getElementById('gs-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('gs-results');
  const trigger = document.getElementById('global-search-trigger');

  let activeIndex = 0;
  let currentResults: any[] = [];

  const isMac = /Mac|iPod|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  const shortcutLabel = document.getElementById('gs-trigger-kbd');
  if (shortcutLabel) shortcutLabel.textContent = isMac ? '⌘K' : 'Ctrl K';
  const escLabel = document.getElementById('gs-esc');
  if (escLabel) escLabel.textContent = isMac ? 'esc' : 'esc';

  function openSearch() {
    if (!overlay) return;
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (input) {
      input.value = '';
      render('');
      // 等待模态可见后再聚焦
      requestAnimationFrame(() => input.focus());
    }
  }

  function closeSearch() {
    if (!overlay) return;
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function escapeHtml(str: string): string {
    return String(str).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string)
    );
  }

  function search(q: string): any[] {
    const data: any[] = (window as any).__SEARCH_INDEX__ || [];
    const s = q.trim().toLowerCase();
    if (!s) return [];
    const scored: { item: any; score: number }[] = [];
    for (const item of data) {
      const title = (item.title || '').toLowerCase();
      const kw = (item.kw || '').toLowerCase();
      const desc = (item.desc || '').toLowerCase();
      let score = 0;
      if (title.startsWith(s)) score = 100;
      else if (title.includes(s)) score = 70;
      else if (kw.includes(s)) score = 50;
      else if (desc.includes(s)) score = 20;
      if (score > 0) scored.push({ item, score });
    }
    scored.sort((a, b) => b.score - a.score);
    return scored.slice(0, 12).map((x) => x.item);
  }

  function highlight(text: string, q: string): string {
    const esc = escapeHtml(text);
    const s = q.trim();
    if (!s) return esc;
    const pattern = s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    try {
      return esc.replace(new RegExp(pattern, 'gi'), (m) => `<mark class="gs-mark">${m}</mark>`);
    } catch {
      return esc;
    }
  }

  function iconSvg(type: string): string {
    return type === 'tutorial'
      ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
  }

  function render(q: string) {
    if (!resultsEl) return;
    currentResults = search(q);
    activeIndex = 0;
    const countEl = document.getElementById('gs-count');

    if (!q.trim()) {
      if (countEl) countEl.textContent = '';
      resultsEl.innerHTML =
        '<div class="gs-empty"><p>输入关键字，搜索全站 200+ 工具与教程</p></div>';
      return;
    }
    if (!currentResults.length) {
      if (countEl) countEl.textContent = '0 个结果';
      resultsEl.innerHTML =
        `<div class="gs-empty"><p>没有找到与「${escapeHtml(q.trim())}」相关的工具或教程</p></div>`;
      return;
    }

    if (countEl) countEl.textContent = `${currentResults.length} 个结果`;

    resultsEl.innerHTML = currentResults
      .map((item, i) => {
        const desc = item.desc ? `${item.subtitle} · ${item.desc}` : item.subtitle;
        return `
        <a href="${item.href}" class="gs-item ${i === activeIndex ? 'is-active' : ''}" data-i="${i}">
          <span class="gs-ico gs-ico-${item.type}">${iconSvg(item.type)}</span>
          <span class="gs-item-main">
            <span class="gs-item-title">${highlight(item.title, q)}</span>
            <span class="gs-item-desc" title="${escapeHtml(desc)}">${escapeHtml(desc)}</span>
          </span>
          <span class="gs-enter" aria-hidden="true">↵</span>
        </a>`;
      })
      .join('');

    resultsEl.querySelectorAll<HTMLElement>('.gs-item').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        go(currentResults[Number(el.dataset.i)]);
      });
      el.addEventListener('mousemove', () => {
        const i = Number(el.dataset.i);
        if (i !== activeIndex) {
          activeIndex = i;
          updateActive();
        }
      });
    });
  }

  function updateActive() {
    if (!resultsEl) return;
    resultsEl.querySelectorAll<HTMLElement>('.gs-item').forEach((el, i) => {
      el.classList.toggle('is-active', i === activeIndex);
    });
    const activeEl = resultsEl.querySelector<HTMLElement>('.gs-item.is-active');
    if (activeEl) activeEl.scrollIntoView({ block: 'nearest' });
  }

  function move(d: number) {
    if (!currentResults.length) return;
    activeIndex = (activeIndex + d + currentResults.length) % currentResults.length;
    updateActive();
  }

  function go(item: any) {
    if (!item) return;
    closeSearch();
    window.location.href = item.href;
  }

  trigger?.addEventListener('click', (e) => {
    e.preventDefault();
    openSearch();
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  if (input) input.addEventListener('input', () => render(input.value));

  document.addEventListener('keydown', (e) => {
    const isK = e.key.toLowerCase() === 'k';
    if ((e.metaKey || e.ctrlKey) && isK) {
      e.preventDefault();
      if (overlay?.classList.contains('is-open')) closeSearch();
      else openSearch();
      return;
    }
    if (!overlay?.classList.contains('is-open')) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      closeSearch();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      move(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      move(-1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      go(currentResults[activeIndex]);
    }
  });
</script>

<style is:global>
  /* 注意：结果列表由 innerHTML 动态插入，拿不到 Astro scoped 属性，
     因此这里必须用 is:global（类名均带 gs- 前缀避免冲突） */
  .gs-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 16px 16px;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
  }
  .gs-overlay.is-open {
    display: flex;
    animation: gs-fade 0.15s ease;
  }
  @keyframes gs-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .gs-modal {
    width: min(680px, 100%);
    max-height: 72vh;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    /* 比全站默认玻璃更通透，背后页面色彩透出、不发灰 */
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(28px) saturate(240%);
    -webkit-backdrop-filter: blur(28px) saturate(240%);
    border: 1px solid var(--glass-border);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.18),
      0 4px 16px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    overflow: hidden;
    animation: gs-pop 0.18s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  @keyframes gs-pop {
    from { transform: translateY(-10px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  /* ---- 输入行 ---- */
  .gs-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 18px;
    border-bottom: 1px solid var(--glass-border-subtle);
    flex-shrink: 0;
  }
  .gs-input-row input,
  .gs-input-row input:focus {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    box-shadow: none;
    font-size: 16px;
    color: var(--color-text);
    /* 输入文字与左侧图标之间留出缩进 */
    padding: 4px 8px;
    border-radius: 0;
  }
  .gs-input-row input::placeholder {
    color: var(--color-text-muted);
  }

  .gs-kbd,
  .gs-footer kbd,
  .gs-enter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-family: inherit;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 6px;
    background: var(--glass-input);
    border: 1px solid var(--glass-border);
    color: var(--color-text-secondary);
    min-width: 20px;
  }

  /* ---- 结果列表 ---- */
  .gs-results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 8px;
  }
  .gs-results::-webkit-scrollbar {
    width: 8px;
  }
  .gs-results::-webkit-scrollbar-thumb {
    background: rgba(128, 128, 128, 0.35);
    border-radius: 4px;
  }
  .gs-results::-webkit-scrollbar-thumb:hover {
    background: rgba(128, 128, 128, 0.55);
  }

  .gs-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.12s ease;
    cursor: pointer;
  }
  .gs-item + .gs-item {
    margin-top: 2px;
  }
  .gs-item.is-active {
    background: var(--glass-input-focus);
    box-shadow: inset 0 0 0 1px var(--glass-border);
  }

  /* 图标磁贴 */
  .gs-ico {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gs-ico svg {
    width: 16px;
    height: 16px;
  }
  .gs-ico-tool {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }
  .gs-ico-tutorial {
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .gs-item-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .gs-item-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gs-mark {
    background: transparent;
    color: var(--color-primary);
    font-weight: 700;
    padding: 0;
  }
  .gs-item-desc {
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 激活项右侧的回车提示 */
  .gs-enter {
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-2px);
    transition: opacity 0.12s ease, transform 0.12s ease;
  }
  .gs-item.is-active .gs-enter {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- 空态 ---- */
  .gs-empty {
    padding: 36px 16px;
    text-align: center;
    color: var(--color-text-muted);
  }
  .gs-empty p {
    margin: 0;
    font-size: 13.5px;
  }

  /* ---- 底部快捷键栏 ---- */
  .gs-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--glass-border-subtle);
    font-size: 12px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .gs-footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .gs-footer kbd {
    margin: 0 1px;
  }
  .gs-count {
    margin-left: auto;
  }

  /* 暗色主题下同样保持通透、偏冷一点避免灰浊 */
  [data-theme="dark"] .gs-modal {
    background: rgba(28, 28, 32, 0.30);
  }
</style>
