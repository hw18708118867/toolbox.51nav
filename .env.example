# Google Analytics 4 Measurement ID
# 格式: G-XXXXXXXXXX
# 留空则不会加载 GA4 脚本
PUBLIC_GA4_ID=

# Google Search Console 验证码
# 填入 Google 提供的验证字符串（HTML 验证方式中的 content 值）
# 留空则不会输出 verification meta 标签
PUBLIC_GSC_VERIFICATION=

# 百度站长验证码（HTML 标签验证方式中 meta 的 content 值，如 codeva-xxxxxxxx）
# 留空则不会输出 baidu-site-verification meta 标签
PUBLIC_BAIDU_VERIFICATION=
